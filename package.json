{
  "name": "mandibuddy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "test": "npm run test --workspaces --if-present",
    "test:changed": "npm run test:changed --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w server",
    "db:migrate:create": "npm run db:migrate:create -w server --",
    "db:seed": "npm run db:seed -w server"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "oxlint": "^1.81.0"
  }
}
